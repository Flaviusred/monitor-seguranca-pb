# Copie este arquivo para ".env" e ajuste. O .env NÃO deve ir para o Git (tem senha).

# Domínio do servidor de testes. Deixe vazio para acessar pelo IP (http, sem HTTPS).
# Com domínio, aponte o DNS (registro A) para o IP do servidor antes de subir.
DOMINIO=

# Senha de acesso ao painel (recomendado em servidor exposto na internet).
# Deixe os dois vazios para acesso livre.
ACESSO_USUARIO=equipe
ACESSO_SENHA=troque-esta-senha

# Intervalo entre coletas, em minutos
COLETA_MINUTOS=5

# Classificação: auto (IA só se houver chave), regras ou claude
CLASSIFICADOR=auto
# Chave da API da Anthropic (opcional; cada coleta passa a ter custo)
ANTHROPIC_API_KEY=
